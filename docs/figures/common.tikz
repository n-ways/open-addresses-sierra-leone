% Shared settings of the paper's figures: fonts, colours and the label language.
% A figure's French build defines \figfr before reading its source (see x.fr.tex).
\usepackage{fontspec}
\setmainfont{LibertinusSans}[Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Italic]
\usepackage{pgfplots,pgfplotstable}
\pgfplotsset{compat=1.18}
\usetikzlibrary{calc}
\definecolor{ink}{HTML}{0B4F8A}
\definecolor{green}{HTML}{1EB53A}
\definecolor{blue}{HTML}{0072C6}
\definecolor{sand}{HTML}{C9B37E}
\definecolor{grey}{HTML}{8A8F98}
\newcommand{\T}[2]{\ifdefined\figfr #2\else #1\fi}
\pgfplotsset{every axis/.append style={font=\small, tick label style={font=\footnotesize},
  label style={font=\small}, axis line style={black!60}, tick style={black!60}}}
% French numbers: decimal comma and a thin space between thousands
\ifdefined\figfr \pgfkeys{/pgf/number format/.cd, use comma, 1000 sep={\,}}\fi
